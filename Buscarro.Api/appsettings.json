{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BuscarroDb": "Server=(localdb)\\mssqllocaldb;Database=BuscarroDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "VehicleCache": {
    "DurationMinutes": 5
  },
  "Carzin": {
    "BaseUrl": "https://carzin.com.br"
  },
  "Jwt": {
    "Issuer": "Buscarro",
    "Audience": "Buscarro.Api",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
