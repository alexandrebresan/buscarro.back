{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BuscarroDb": "Host=localhost;Port=5432;Database=BuscarroDb;Username=postgres;Password=postgres"
  },
  "VehicleCache": {
    "DurationMinutes": 5
  },
  "Carzin": {
    "BaseUrl": "https://carzin.com.br"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://auto-match-wine.vercel.app"
    ]
  },
  "Jwt": {
    "Issuer": "Buscarro",
    "Audience": "Buscarro.Api",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
