{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BuscarroDb": ""
  },
  "CatalogQuery": {
    "CommandTimeoutSeconds": 10,
    "PageCacheTtlSeconds": 15,
    "CountCacheTtlSeconds": 30,
    "CacheSizeLimit": 2000
  },
  "CatalogReadiness": {
    "MaximumCatalogAge": "12:00:00",
    "DatabaseTimeout": "00:00:03",
    "AllowedClockSkew": "00:05:00"
  },
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com",
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://auto-match-wine.vercel.app"
    ]
  },
  "Jwt": {
    "Issuer": "Buscarro",
    "Audience": "Buscarro.Api",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
