FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Buscarro.CatalogSync.Worker/Buscarro.CatalogSync.Worker.csproj
RUN dotnet publish src/Buscarro.CatalogSync.Worker/Buscarro.CatalogSync.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:9.0
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "Buscarro.CatalogSync.Worker.dll"]
